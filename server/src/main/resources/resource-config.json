      },
      {
        "pattern": ".*\\.xml$"
      },
      {
        "pattern": ".*\\.yaml$"
      },
      {
        "pattern": ".*\\.yml$"
      },
      {
        "pattern": ".*\\.json$"
      },
      {
        "pattern": ".*\\.sql$"
      },
      {
        "pattern": ".*\\.html$"
      },
      {
        "pattern": ".*\\.css$"
      },
      {
        "pattern": ".*\\.js$"
      },
      {
        "pattern": ".*\\.png$"
      },
      {
        "pattern": ".*\\.jpg$"
      },
      {
        "pattern": ".*\\.gif$"
      },
      {
        "pattern": ".*\\.ico$"
